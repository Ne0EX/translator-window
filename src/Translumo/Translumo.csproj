<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Resources\Icons\favicon.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- No cloud adapters, updater, or legacy Python downloads in the local executable. -->
  <ItemGroup><PackageReference Include="Tesseract" Version="5.2.0" /><Content Include="../../models/tessdata/*" Link="tessdata/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ApplicationDefinition Include="App.xaml" />
    <Compile Include="App.xaml.cs;Local\**\*.cs;SelectionAreaWindow.xaml.cs" />
    <Page Include="SelectionAreaWindow.xaml" />
    <Resource Include="Resources\Icons\favicon.ico" />
    <Content Include="..\..\local-model\worker.py" Link="local-model\worker.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
